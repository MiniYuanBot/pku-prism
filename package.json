{
  "name": "pku-prism",
  "version": "0.4.3",
  "private": true,
  "description": "A reversible UI and UX redesign userscript for PKU Blackboard Learn.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
